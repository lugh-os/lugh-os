# live-build working state (scripts/build-iso.sh builds in a copy inside the
# container, but running lb by hand in iso/ creates these)
/.build/
/cache/
/chroot/
/binary/
/local/
/build.log
/chroot.files
/chroot.packages.*
/binary.modified_timestamps
/lugh-*.contents
/lugh-*.files
/lugh-*.packages
/lugh-*.hybrid.iso
/lugh-*.iso
/lugh-*.zsync
/*.iso

# Generated by `lb config`
/config/binary
/config/bootstrap
/config/chroot
/config/common
/config/source
/config/build
# (stock hook symlinks; Lugh hooks are named NNNN-lugh-*)
/config/hooks/normal/*
!/config/hooks/normal/*-lugh-*
/config/hooks/live/*
!/config/hooks/live/*-lugh-*

# Staged by scripts/build-iso.sh (never committed)
/config/archives/lugh.key.chroot
/config/includes.chroot/etc/apt/keyrings/lugh.asc
/config/bootloaders/grub-pc/live-theme/
