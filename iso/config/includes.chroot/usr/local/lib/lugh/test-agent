#!/bin/bash
# Lugh test agent (live image, test VMs only; see 90-lugh-test.rules).
#
# Protocol on the virtio-serial port, one request per line:
#   host  -> <base64 of a shell command>\n
#   guest -> the command's stdout+stderr, then  \n@@LUGH-RC:<exit code>@@\n
# The command runs as root with bash. `as-user <cmd>` inside it runs <cmd> as
# the logged-in desktop user with their session bus and Wayland display.
set -u
port=${1:?usage: test-agent <port device>}

as_user_def='as-user() {
    local u uid
    u=$(loginctl list-sessions --no-legend 2>/dev/null | awk "\$3 != \"_greetd\" && \$3 != \"root\" {print \$3; exit}")
    u=${u:-lugh}; uid=$(id -u "$u")
    local wl; wl=$(cd /run/user/$uid 2>/dev/null && ls -d wayland-[0-9] 2>/dev/null | head -n1)
    local sig; sig=$(ls -t /run/user/$uid/hypr 2>/dev/null | head -n1)
    runuser -u "$u" -- env XDG_RUNTIME_DIR=/run/user/$uid \
        DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus \
        WAYLAND_DISPLAY=${wl:-wayland-1} HYPRLAND_INSTANCE_SIGNATURE=$sig \
        HOME=$(getent passwd "$u" | cut -d: -f6) bash -c "$*"
}'

exec 3<>"$port"
while :; do
    if IFS= read -r line <&3; then
        [ -n "$line" ] || continue
        cmd=$(printf '%s' "$line" | base64 -d 2>/dev/null) || { printf '\n@@LUGH-RC:255@@\n' >&3; continue; }
        bash -c "$as_user_def"$'\n'"$cmd" </dev/null >&3 2>&1
        printf '\n@@LUGH-RC:%s@@\n' "$?" >&3
    else
        sleep 0.5   # host side not connected
    fi
done
