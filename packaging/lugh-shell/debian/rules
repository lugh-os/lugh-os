#!/usr/bin/make -f
# The binary is built from the repo checkout (LUGH_REPO_ROOT, exported by
# scripts/build-debs.sh) with the commands of scripts/build-shell.sh, reusing its
# cargo target dir; an up-to-date out/bin/lugh-shell is reused as is. See
# scripts/build-env/cargo-deb-build.sh and docs/dev/packaging.md.

LUGH_REPO_ROOT ?= /src

%:
	dh $@

override_dh_auto_build:
	CXXFLAGS=-Wno-overloaded-virtual $(LUGH_REPO_ROOT)/scripts/build-env/cargo-deb-build.sh \
	  lugh-shell ui/shell/Cargo.toml out/shell-target build/lugh-shell

override_dh_auto_clean:
	rm -rf build

# cargo already stripped what the release profile asks for; no -dbgsym.
override_dh_strip:
	dh_strip --no-automatic-dbgsym
