# Lugh build environment: Debian 13 "trixie" with everything needed to build
# Lugh .deb packages, publish the local apt repo and build the live ISO.
#
# Built and used through scripts/lib/container.sh (podman, or docker as a
# fallback). The image is tagged localhost/lugh-build-env:trixie and labelled
# with the sha256 of this file, so editing it triggers a rebuild.
FROM debian:trixie

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    RUSTUP_HOME=/root/.rustup \
    CARGO_HOME=/root/.cargo \
    PATH=/root/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      live-build debootstrap \
      xorriso squashfs-tools mtools dosfstools \
      grub-efi-amd64-bin grub-pc-bin grub-efi-amd64-signed shim-signed \
      syslinux isolinux syslinux-common \
      build-essential debhelper devscripts fakeroot lintian config-package-dev \
      aptly gnupg \
      librsvg2-bin python3 \
      ca-certificates curl rsync \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# lugh-shell and lugh-greeter (Rust + cxx-qt + Qt 6, see docs/dev/packaging.md):
# the Qt 6 dev packages, PAM headers for the lock screen, and what their
# package builds call (dbus-run-session for `--check`, desktop-file-validate).
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      pkg-config cmake git \
      qt6-base-dev qt6-declarative-dev qt6-declarative-dev-tools \
      libpam0g-dev \
      dbus-daemon dbus-bin desktop-file-utils \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# lugh-hyprbars (packaging/lugh-hyprbars): a Hyprland plugin, built against
# the hyprland-dev of trixie-backports, the Hyprland Lugh ships. Only the
# Hyprland stack comes from backports (same pin as iso/config/archives).
RUN echo 'deb http://deb.debian.org/debian trixie-backports main' \
      > /etc/apt/sources.list.d/trixie-backports.list \
 && printf '%s\n' 'Package: hyprland hyprland-* libhypr* libaquamarine* libxkbcommon* libxkbregistry* xkb-data' \
      'Pin: release n=trixie-backports' 'Pin-Priority: 990' \
      > /etc/apt/preferences.d/lugh-hyprland \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      hyprland hyprland-dev liblua5.4-dev libpixman-1-dev libdrm-dev libinput-dev \
      libudev-dev libwayland-dev libxkbcommon-dev pkgconf \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# rustup only. The toolchain named in rust-toolchain.toml is installed at build
# time (`rustup toolchain install`) into the lugh-hello-rustup volume that
# scripts/lib/container.sh mounts on /root/.rustup, so a toolchain bump does not
# rebuild this image and the download is shared with `make shell` / `make hello`.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --no-modify-path --profile minimal --default-toolchain none

WORKDIR /src
